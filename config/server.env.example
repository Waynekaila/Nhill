# Nhill server configuration — EXAMPLE, contains no secret.
# Copy to /etc/nhill/server.env, fill in, then:
#   chown nhill:nhill /etc/nhill/server.env && chmod 600 /etc/nhill/server.env
# (the server refuses a file readable by its group or by others).
# Every key can also be given as an environment variable of the same name.

# --- database (PostgreSQL 16). Two roles: the application role (no table
#     ownership, subject to row-level security) and the migration owner.
NH_DATABASE_URL=host=127.0.0.1 port=5432 dbname=nhill user=nhill_app password=CHANGE_ME sslmode=prefer
NH_MIGRATION_DATABASE_URL=host=127.0.0.1 port=5432 dbname=nhill user=nhill_owner password=CHANGE_ME sslmode=prefer
NH_DB_POOL_SIZE=16

# --- HTTP (behind the TLS reverse proxy: listen on loopback only)
NH_LISTEN_ADDRESS=127.0.0.1
NH_LISTEN_PORT=8080
NH_THREADS=16
# 1 only when a trusted reverse proxy sets X-Forwarded-For (needed for rate limits per IP)
NH_TRUST_PROXY=1

# --- secrets. Generate with:  openssl rand -hex 32
# Losing this key makes establishment codes and admin TOTP secrets unreadable
# (codes can be reissued, admins must redo their first access). Back it up
# separately from the database backups.
NH_SECRET_KEY=
# Payment provider webhook secrets (>= 32 characters), one per provider:
# NH_WEBHOOK_SECRET_GENERIC=

# --- sessions and hashing
NH_ACCESS_TOKEN_MINUTES=15
NH_REFRESH_TOKEN_DAYS=30
NH_ARGON2_OPS=3
NH_ARGON2_MEM_KIB=65536

# --- background jobs (code rotation, subscription lifecycle, e-mails)
NH_JOBS_INTERVAL_SECONDS=300
# "log" only writes e-mails to the server log (no SMTP transport is implemented yet)
NH_EMAIL_TRANSPORT=log

# --- data files (defaults match `cmake --install` with prefix /usr)
NH_PROFILE_DIR=/usr/share/nhill/profiles
NH_I18N_DIR=/usr/share/nhill/i18n
NH_FONT_DIR=/usr/share/nhill/fonts
NH_MIGRATIONS_DIR=/usr/share/nhill/migrations
