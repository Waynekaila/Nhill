# /etc/nhill/backup.env (chmod 600) — EXAMPLE, no secret here.
# Read-only backup role (db/bootstrap/01-backup-role.sql): the owner and the
# application role cannot dump business tables (forced row-level security).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nhill
PGUSER=nhill_backup
# Password through ~/.pgpass of the backup user (recommended) or PGPASSWORD.
# age public key(s) the backups are encrypted to. The PRIVATE key must be kept
# offline (never on this server): it is needed only to restore.
NH_BACKUP_RECIPIENTS="age1replace_with_your_public_key"
NH_BACKUP_DIR=/var/backups/nhill
NH_BACKUP_KEEP_DAYS=30
# Optional: copy each backup off-site (rclone remote, rsync target...)
# NH_BACKUP_OFFSITE_CMD="rclone copy {} remote:nhill-backups/"
