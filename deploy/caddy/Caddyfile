# Nhill — TLS reverse proxy (Caddy 2). Caddy obtains and renews the
# certificate automatically (ACME). Replace api.example.com by your domain.
api.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Largest legitimate body: a 5 MB receipt / product import.
	request_body {
		max_size 6MB
	}

	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}

	log {
		output file /var/log/caddy/nhill-access.log {
			roll_size 50MiB
			roll_keep 10
			# Access logs hold IP addresses: kept 90 days at most.
			roll_keep_for 2160h
		}
		format json
	}
}
