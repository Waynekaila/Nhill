# Nhill website: static files + form backend on the same address (no CORS needed then).
# Replace www.example.cd; Caddy obtains the TLS certificate automatically.
www.example.cd {
	encode zstd gzip
	root * /var/www/nhill-site
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
	@static path /assets/*
	header @static Cache-Control "public, max-age=604800"
	handle /api/* {
		request_body {
			max_size 32KB
		}
		reverse_proxy 127.0.0.1:8090 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		# Never serve backend sources, configuration or data
		@private path /backend/* /src/* /tools/* *.env *.sqlite3 *.py
		respond @private 404
		file_server
	}
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
