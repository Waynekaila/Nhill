# Nhill website form backend — EXAMPLE configuration (no real secret here).
# Copy to /etc/nhill-site/site.env, replace every CHANGE_ME, then:
#   chown nhill-site:nhill-site /etc/nhill-site/site.env && chmod 600 /etc/nhill-site/site.env
# This file is read by the SERVER only. Never copy it into the public website folder.

# --- database (distinct from the Nhill application database) ---------------
# sqlite (default, one private file) or postgresql (dedicated database + roles)
SITE_DATABASE_ENGINE=sqlite
SITE_SQLITE_PATH=/var/lib/nhill-site/site.sqlite3
# PostgreSQL only:
SITE_DATABASE_HOST=127.0.0.1
SITE_DATABASE_PORT=5432
SITE_DATABASE_NAME=nhill_site
SITE_DATABASE_USER=nhill_site_app
SITE_DATABASE_PASSWORD=CHANGE_ME
# disable | prefer | require | verify-full (use require or verify-full over a network)
SITE_DATABASE_SSLMODE=require
# Maintenance CLI (read, export, delete) — PostgreSQL only:
SITE_MAINTENANCE_DATABASE_USER=nhill_site_maint
SITE_MAINTENANCE_DATABASE_PASSWORD=CHANGE_ME

# --- HTTP --------------------------------------------------------------------
SITE_LISTEN_HOST=127.0.0.1
SITE_LISTEN_PORT=8090
# Origins allowed to post the forms (the public site address), comma-separated
SITE_ALLOWED_ORIGINS=https://www.CHANGE_ME.cd
# 1 only behind a reverse proxy that sets X-Forwarded-For (Caddy below)
SITE_TRUST_PROXY=1
SITE_PUBLIC_BASE_URL=https://www.CHANGE_ME.cd
SITE_API_BASE_URL=https://www.CHANGE_ME.cd

# --- privacy and abuse protection ----------------------------------------------
# Secret used to fingerprint IP addresses (HMAC). Generate: openssl rand -hex 32
SITE_IP_HASH_SALT=CHANGE_ME_64_HEX_CHARACTERS
SITE_RETENTION_DAYS=365
SITE_IP_RETENTION_DAYS=30
SITE_MIN_FILL_MS=3000
SITE_RATE_PER_HOUR=5
SITE_RATE_PER_DAY_GLOBAL=300

# --- contact and optional e-mail notification ---------------------------------
SITE_CONTACT_EMAIL=contact@CHANGE_ME.cd
SITE_NOTIFY_EMAIL=
SITE_SMTP_HOST=
SITE_SMTP_PORT=587
SITE_SMTP_USER=
SITE_SMTP_PASSWORD=
SITE_SMTP_FROM=
