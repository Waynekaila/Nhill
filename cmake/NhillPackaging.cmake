# Debian packages (one per application) built with CPack:
#   cmake --build build --target package    (or: cd build && cpack -G DEB)
# Produces nhill-server, nhill-business, nhill-console and nhill-pos .deb files.
# Shared-library dependencies are computed by dpkg-shlibdeps; QML modules, which are
# not linked libraries, are listed explicitly.
if(NOT UNIX OR APPLE OR ANDROID)
    return()
endif()

set(CPACK_GENERATOR "DEB")
set(CPACK_PACKAGE_NAME "nhill")
set(CPACK_PACKAGE_VENDOR "Nhill Solution")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_CONTACT "Nhill Solution <support@nhill.online>")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_DEB_COMPONENT_INSTALL ON)
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_SECTION "misc")
set(CPACK_STRIP_FILES ON)

set(_qml_deps "qml6-module-qtquick, qml6-module-qtquick-controls, qml6-module-qtquick-layouts, qml6-module-qtquick-templates, qml6-module-qtquick-window, qml6-module-qtqml-workerscript, qml6-module-qtquick-dialogs, libqt6svg6")

set(_components)
if(NHILL_BUILD_SERVER)
    list(APPEND _components server)
    set(CPACK_DEBIAN_SERVER_PACKAGE_NAME "nhill-server")
    set(CPACK_DEBIAN_SERVER_PACKAGE_SECTION "net")
    set(CPACK_DEBIAN_SERVER_PACKAGE_DEPENDS "adduser, systemd")
    set(CPACK_DEBIAN_SERVER_PACKAGE_RECOMMENDS "postgresql (>= 15) | postgresql-client, caddy")
    set(CPACK_DEBIAN_SERVER_PACKAGE_SUGGESTS "age")
    set(CPACK_COMPONENT_SERVER_DESCRIPTION "Nhill API server (multi-establishment backend)\n Serves Nhill Business, Nhill POS and Nhill Console over HTTPS (behind a reverse\n proxy). On first start without a database it runs in setup mode: the operator\n installs the PostgreSQL / Supabase database from Nhill Console with a one-time\n token printed in the journal.")
    set(CPACK_DEBIAN_SERVER_PACKAGE_CONTROL_EXTRA
        "${PROJECT_SOURCE_DIR}/packaging/debian/server/postinst;${PROJECT_SOURCE_DIR}/packaging/debian/server/prerm;${PROJECT_SOURCE_DIR}/packaging/debian/server/postrm")
    set(CPACK_DEBIAN_SERVER_PACKAGE_CONTROL_STRICT_PERMISSION TRUE)
endif()
if(NHILL_BUILD_CLIENT)
    list(APPEND _components business console pos)
    set(CPACK_DEBIAN_BUSINESS_PACKAGE_NAME "nhill-business")
    set(CPACK_DEBIAN_BUSINESS_PACKAGE_SECTION "office")
    set(CPACK_DEBIAN_BUSINESS_PACKAGE_DEPENDS "${_qml_deps}")
    set(CPACK_COMPONENT_BUSINESS_DESCRIPTION "Nhill Business — sales, invoices, stock and payments\n Desktop application for traders, independent entrepreneurs and SMEs. Connects to\n a Nhill server; no database credential is stored on the computer.")
    set(CPACK_DEBIAN_CONSOLE_PACKAGE_NAME "nhill-console")
    set(CPACK_DEBIAN_CONSOLE_PACKAGE_SECTION "admin")
    set(CPACK_DEBIAN_CONSOLE_PACKAGE_DEPENDS "${_qml_deps}")
    set(CPACK_COMPONENT_CONSOLE_DESCRIPTION "Nhill Console — private administration of the Nhill platform\n For the Nhill operators: establishments, subscriptions, plans, promo codes, payment\n providers, support tickets, audit and server installation. Requires a platform\n administrator account with TOTP.")
    set(CPACK_DEBIAN_POS_PACKAGE_NAME "nhill-pos")
    set(CPACK_DEBIAN_POS_PACKAGE_SECTION "office")
    set(CPACK_DEBIAN_POS_PACKAGE_DEPENDS "${_qml_deps}")
    set(CPACK_COMPONENT_POS_DESCRIPTION "Nhill POS — cash register for a Nhill Business establishment\n Cash sessions with opening float and closing count, sales with several payment\n methods, returns and voids with supervisor approval, receipts and X/Z reports.")
endif()
set(CPACK_COMPONENTS_ALL ${_components})
include(CPack)
